{
  "manifest_version": 3,
  "name": "Atom Viewer",
  "version": "0.1.0",
  "description": "Right-click .xyz / .extxyz / .pdb / .cif / POSCAR files on GitHub or any web page and view the 3D atomic structure in a docked panel.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Atom Viewer: view the structure file on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "View the structure file on this page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer/*", "vendor/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
